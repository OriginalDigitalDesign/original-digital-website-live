# Original Digital: deployed from GitHub (public/.htaccess). Edit there, not on the server.

# Send www.originaldigital.co.za to the main address (permanent redirect).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.originaldigital\.co\.za$ [NC]
  RewriteRule ^(.*)$ https://originaldigital.co.za/$1 [R=301,L]
</IfModule>

# Use the site's own 404 page.
ErrorDocument 404 /404.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
